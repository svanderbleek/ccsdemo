{:paths ["src/clj" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}}

 :aliases {:cljs
           {:paths ["src/cljs"]
            :deps {thheller/shadow-cljs {:mvn/version "3.5.3"}
                   re-frame/re-frame    {:mvn/version "1.4.7"}
                   reagent/reagent      {:mvn/version "2.0.1"}}}
           :run
           {:main-opts ["-m" "ccsdemo.main"]}
           :build
           {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
            :extra-paths ["src/cljs"]
            :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.3"}
                         re-frame/re-frame    {:mvn/version "1.4.7"}
                         reagent/reagent      {:mvn/version "2.0.1"}}
            :ns-default build}}}
